// app/reservasi-kunjungan/page.tsx
// FINAL
// ============================================

"use client";

import { useState } from "react";

import Navbar from "@/components/Navbar";
import Footer from "@/components/Footer";

export default function ReservasiKunjunganPage() {

  const [loading, setLoading] = useState(false);
  const [success, setSuccess] = useState(false);

  const handleSubmit = async (
    e: React.FormEvent<HTMLFormElement>
  ) => {

    e.preventDefault();

    setLoading(true);

    const formData = new FormData(
      e.currentTarget
    );

    const payload = {
      nama: formData.get("nama"),
      instansi: formData.get("instansi"),
      telepon: formData.get("telepon"),
      email: formData.get("email"),
      tanggal: formData.get("tanggal"),
      waktu: formData.get("waktu"),
      peserta: formData.get("peserta"),
      jenis: formData.get("jenis"),
      catatan: formData.get("catatan"),
    };

    try {

      const res = await fetch(
        "/api/reservasi",
        {
          method: "POST",
          headers: {
            "Content-Type":
              "application/json",
          },
          body: JSON.stringify(
            payload
          ),
        }
      );

      const result = await res.json();

      if (result.success) {

        setSuccess(true);

        e.currentTarget.reset();

        setTimeout(() => {
          setSuccess(false);
        }, 5000);
      }

    } catch (error) {

      console.error(error);

      alert(
        "Gagal menyimpan data"
      );
    }

    setLoading(false);
  };

  return (
    <>
      {/* NAVBAR */}
      <Navbar />

      {/* PAGE */}
      <main className="min-h-screen bg-[#F5F7FA] pt-36 pb-24">

        <div className="max-w-3xl mx-auto px-6">

          {/* CARD */}
          <div className="bg-white rounded-[32px] shadow-xl border border-[#E8EDF3] p-8 lg:p-10">

            {/* HEADER */}
            <div className="mb-10">

              <p className="uppercase tracking-[0.25em] text-[#7A8599] text-sm">
                Reservasi
              </p>

              <h1 className="text-4xl lg:text-5xl font-bold mt-4 text-[#0D2341]">
                Reservasi Kunjungan
              </h1>

              <p className="text-[#667085] mt-4 text-lg leading-relaxed">
                Form pendaftaran
                kunjungan Masjid Raya
                Al-Jabbar untuk wisata
                religi, edukasi sekolah,
                komunitas, dan kegiatan
                lainnya.
              </p>

            </div>

            {/* SUCCESS */}
            {success && (

              <div className="mb-8 bg-green-50 border border-green-200 rounded-2xl p-5">

                <h3 className="text-green-700 font-semibold text-lg">
                  Reservasi berhasil
                  dikirim
                </h3>

                <p className="text-green-600 mt-2">
                  Data kunjungan telah
                  tersimpan.
                </p>

                <div className="mt-5 flex flex-wrap gap-3">

                  <a
                    href="/"
                    className="bg-[#123A63] hover:bg-[#0f3153] transition text-white px-5 py-3 rounded-xl"
                  >
                    Kembali ke Beranda
                  </a>

                  <a
                    href="/jadwal-kunjungan"
                    className="border border-[#D0D5DD] hover:bg-gray-50 transition px-5 py-3 rounded-xl text-[#0D2341]"
                  >
                    Lihat Jadwal
                  </a>

                </div>
              </div>
            )}

            {/* FORM */}
            <form
              onSubmit={handleSubmit}
              className="space-y-5"
            >

              {/* NAMA */}
              <input
                name="nama"
                type="text"
                placeholder="Nama Penanggung Jawab"
                required
                className="w-full h-14 px-5 rounded-2xl border border-[#D0D5DD]"
              />

              {/* INSTANSI */}
              <input
                name="instansi"
                type="text"
                placeholder="Instansi / Komunitas"
                required
                className="w-full h-14 px-5 rounded-2xl border border-[#D0D5DD]"
              />

              {/* TELEPON */}
              <input
                name="telepon"
                type="text"
                placeholder="Nomor Telepon"
                required
                className="w-full h-14 px-5 rounded-2xl border border-[#D0D5DD]"
              />

              {/* EMAIL */}
              <input
                name="email"
                type="email"
                placeholder="Email"
                required
                className="w-full h-14 px-5 rounded-2xl border border-[#D0D5DD]"
              />

              {/* DATE + TIME */}
              <div className="grid md:grid-cols-2 gap-5">

                <input
                  name="tanggal"
                  type="date"
                  required
                  className="w-full h-14 px-5 rounded-2xl border border-[#D0D5DD]"
                />

                <input
                  name="waktu"
                  type="time"
                  required
                  className="w-full h-14 px-5 rounded-2xl border border-[#D0D5DD]"
                />

              </div>

              {/* PESERTA */}
              <input
                name="peserta"
                type="number"
                placeholder="Jumlah Peserta"
                required
                className="w-full h-14 px-5 rounded-2xl border border-[#D0D5DD]"
              />

              {/* JENIS */}
              <select
                name="jenis"
                className="w-full h-14 px-5 rounded-2xl border border-[#D0D5DD]"
              >
                <option>
                  Wisata Religi
                </option>

                <option>
                  Edukasi Sekolah
                </option>

                <option>
                  Studi Arsitektur
                </option>

                <option>
                  Kunjungan Komunitas
                </option>
              </select>

              {/* CATATAN */}
              <textarea
                name="catatan"
                rows={5}
                placeholder="Catatan Tambahan"
                className="w-full p-5 rounded-2xl border border-[#D0D5DD]"
              />

              {/* BUTTON */}
              <button
                type="submit"
                disabled={loading}
                className="w-full h-14 rounded-2xl bg-[#123A63] hover:bg-[#0f3153] transition text-white font-semibold shadow-lg"
              >
                {loading
                  ? "Mengirim..."
                  : "Kirim Reservasi"}
              </button>

            </form>
          </div>
        </div>
      </main>

      {/* FOOTER */}
      <Footer />
    </>
  );
}