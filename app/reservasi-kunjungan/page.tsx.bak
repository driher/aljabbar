"use client";

import { useState } from "react";

export default function ReservasiKunjunganPage() {

  const [loading, setLoading] = useState(false);
  const [success, setSuccess] = useState(false);

  const handleSubmit = async (
    e: React.FormEvent<HTMLFormElement>
  ) => {

    e.preventDefault();

    setLoading(true);

    const formData = new FormData(e.currentTarget);

    const payload = {
      nama: formData.get("nama"),
      instansi: formData.get("instansi"),
      telepon: formData.get("telepon"),
      email: formData.get("email"),
      tanggal: formData.get("tanggal"),
      waktu: formData.get("waktu"),
      peserta: formData.get("peserta"),
      jenis: formData.get("jenis"),
      catatan: formData.get("catatan"),
    };

    try {

      const res = await fetch("/api/reservasi", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(payload),
      });

      const result = await res.json();

      if (result.success) {

        setSuccess(true);

        e.currentTarget.reset();

        setTimeout(() => {
          setSuccess(false);
        }, 4000);
      }

    } catch (error) {

      console.error(error);

      alert("Gagal menyimpan data");
    }

    setLoading(false);
  };

  return (
    <main className="min-h-screen bg-[#F5F7FA] pt-32 pb-24">

      <div className="max-w-3xl mx-auto px-6">

        <div className="bg-white rounded-[32px] shadow-xl border border-[#E8EDF3] p-8">

          <h1 className="text-4xl font-bold mb-2">
            Reservasi Kunjungan
          </h1>

          <p className="text-[#667085] mb-8">
            Form pendaftaran kunjungan Masjid Raya Al-Jabbar
          </p>

          {success && (
            <div className="mb-6 bg-green-50 border border-green-200 text-green-700 rounded-2xl px-5 py-4">
              Reservasi berhasil dikirim
            </div>
          )}

          <form
            onSubmit={handleSubmit}
            className="space-y-5"
          >

            <input
              name="nama"
              type="text"
              placeholder="Nama Penanggung Jawab"
              required
              className="w-full h-14 px-5 rounded-2xl border border-[#D0D5DD]"
            />

            <input
              name="instansi"
              type="text"
              placeholder="Instansi / Komunitas"
              required
              className="w-full h-14 px-5 rounded-2xl border border-[#D0D5DD]"
            />

            <input
              name="telepon"
              type="text"
              placeholder="Nomor Telepon"
              required
              className="w-full h-14 px-5 rounded-2xl border border-[#D0D5DD]"
            />

            <input
              name="email"
              type="email"
              placeholder="Email"
              required
              className="w-full h-14 px-5 rounded-2xl border border-[#D0D5DD]"
            />

            <div className="grid md:grid-cols-2 gap-5">

              <input
                name="tanggal"
                type="date"
                required
                className="w-full h-14 px-5 rounded-2xl border border-[#D0D5DD]"
              />

              <input
                name="waktu"
                type="time"
                required
                className="w-full h-14 px-5 rounded-2xl border border-[#D0D5DD]"
              />

            </div>

            <input
              name="peserta"
              type="number"
              placeholder="Jumlah Peserta"
              required
              className="w-full h-14 px-5 rounded-2xl border border-[#D0D5DD]"
            />

            <select
              name="jenis"
              className="w-full h-14 px-5 rounded-2xl border border-[#D0D5DD]"
            >
              <option>Wisata Religi</option>
              <option>Edukasi Sekolah</option>
              <option>Studi Arsitektur</option>
              <option>Kunjungan Komunitas</option>
            </select>

            <textarea
              name="catatan"
              rows={5}
              placeholder="Catatan Tambahan"
              className="w-full p-5 rounded-2xl border border-[#D0D5DD]"
            />

            <button
              type="submit"
              disabled={loading}
              className="w-full h-14 rounded-2xl bg-[#123A63] text-white font-semibold"
            >
              {loading ? "Mengirim..." : "Kirim Reservasi"}
            </button>

          </form>
        </div>
      </div>
    </main>
  );
}