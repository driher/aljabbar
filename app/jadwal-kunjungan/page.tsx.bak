import fs from "fs";
import path from "path";

export default async function JadwalKunjunganPage() {

  const filePath = path.join(
    process.cwd(),
    "data",
    "reservasi.json"
  );

  let data = [];

  if (fs.existsSync(filePath)) {

    const fileContent = fs.readFileSync(
      filePath,
      "utf-8"
    );

    data = JSON.parse(fileContent || "[]");
  }

  // tanggal hari ini
  const today = new Date();

  // filter tanggal lewat
  const upcoming = data.filter((item: any) => {

    const visitDate = new Date(item.tanggal);

    return visitDate >= new Date(
      today.getFullYear(),
      today.getMonth(),
      today.getDate()
    );
  });

  // urutkan tanggal terdekat
  upcoming.sort((a: any, b: any) => {
    return (
      new Date(a.tanggal).getTime() -
      new Date(b.tanggal).getTime()
    );
  });

  return (
    <main className="min-h-screen bg-[#F5F7FA] pt-32 pb-24">

      <div className="max-w-5xl mx-auto px-6">

        <div className="mb-12">

          <h1 className="text-5xl font-bold">
            Jadwal Kunjungan
          </h1>

          <p className="text-[#667085] mt-3">
            Agenda reservasi pengunjung Masjid Raya Al-Jabbar
          </p>

        </div>

        <div className="grid gap-6">

          {upcoming.length === 0 && (
            <div className="bg-white rounded-3xl border border-[#E8EDF3] p-10 text-center">
              Belum ada jadwal kunjungan
            </div>
          )}

          {upcoming.map((item: any) => (

            <div
              key={item.id}
              className="bg-white rounded-3xl border border-[#E8EDF3] shadow-lg p-8"
            >

              <div className="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">

                <div>

                  <h2 className="text-2xl font-bold">
                    {item.instansi}
                  </h2>

                  <div className="mt-4 space-y-2 text-[#667085]">

                    <p>
                      Penanggung Jawab:
                      {" "}
                      {item.nama}
                    </p>

                    <p>
                      Jenis:
                      {" "}
                      {item.jenis}
                    </p>

                    <p>
                      Peserta:
                      {" "}
                      {item.peserta}
                      {" "}
                      orang
                    </p>

                    <p>
                      Tanggal:
                      {" "}
                      {item.tanggal}
                    </p>

                    <p>
                      Waktu:
                      {" "}
                      {item.waktu}
                    </p>

                  </div>

                </div>

                <div className="bg-[#123A63] text-white px-6 py-4 rounded-2xl text-center min-w-[140px]">

                  <p className="text-sm text-white/70">
                    Agenda
                  </p>

                  <h3 className="text-2xl font-bold mt-1">
                    Aktif
                  </h3>

                </div>

              </div>

            </div>
          ))}

        </div>
      </div>
    </main>
  );
}